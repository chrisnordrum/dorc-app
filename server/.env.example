# Copy to .env and fill in real values. Never commit .env.

PORT=5050

# MongoDB Atlas connection string (Mongoose driver), including the database name.
MONGODB_URI=

# Google OAuth credentials from https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Generate each of these SEPARATELY — never reuse one value across two vars:
#   openssl rand -hex 64
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
SESSION_SECRET=

# Must be EXACTLY 16 bytes: the current implementation uses AES-128-CBC and
# passes this string straight to createCipheriv as the key.
#   openssl rand -hex 8
EMAIL_ENCRYPTION_SECRET=
BIO_ENCRYPTION_SECRET=
